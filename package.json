{
	"name": "nicrainha",
	"version": "0.0.0",
	"description": "Perceptually-uniform color palettes from the CIE Lab color space, and an animated nicrainha background with refracting glass for the web.",
	"keywords": [
		"color",
		"palette",
		"cielab",
		"perceptual",
		"color-science",
		"ansi",
		"webgl",
		"glass",
		"custom-elements"
	],
	"license": "MIT",
	"homepage": "https://github.com/hcubasd/nicrainha#readme",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"repository": {
		"type": "git",
		"url": "https://github.com/hcubasd/nicrainha"
	},
	"scripts": {
		"test": "vitest",
		"build": "tsc --rootDir src --outDir dist && node scripts/tables.js"
	},
	"engines": {
		"node": ">=23.0.0 <27"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"./dist/index.js",
		"./dist/ui/elements.js"
	],
	"devDependencies": {
		"@tsconfig/node23": "^23.0.6",
		"@types/node": "^22.20.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
